# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local database (a projection of the app, never a source of truth)
/.data/
*.db
*.db-journal
*.db-shm
*.db-wal

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Import working files. All regenerable from the two scripts, and a dump of
# somebody else's public directory is not ours to vendor into a repository:
#   npm run launchllama:fetch
#   npm run launchllama:score -- --in=data/launchllama.csv --enrich
/data/

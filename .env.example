# --- Database -------------------------------------------------------------
# Local development: a SQLite file. Production: a Turso/libSQL URL.
DATABASE_URL="file:./.data/stackgraph.db"
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN=""
#
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN work too: those are the names Turso's
# Vercel integration sets, so provisioning from the import screen needs nothing
# typed by hand. The DATABASE_* names win if both are set.

# --- Public URL -----------------------------------------------------------
# Used for share links, claim links and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email ----------------------------------------------------------------
# With no RESEND_API_KEY, every notification is written to the `notifications`
# table and printed to the server log instead of being delivered. In
# development (`next dev`) sign-in and claim links are then also shown on
# screen so the loop can be walked end to end locally.
#
# That never happens on a production or Vercel deployment: there, a missing
# key makes "Email me a link" refuse with a clear message, because a link on
# screen would sign in whoever typed the address. Production needs the key,
# and Resend needs the EMAIL_FROM domain verified, or sends are refused.
# RESEND_API_KEY=""
EMAIL_FROM="Who Uses What <hello@whouseswhat.tech>"

# --- Sign-in ----------------------------------------------------------------
# Google is optional: without these the button is not rendered and sign-in by
# email link works on its own. Redirect URI to register with Google:
#   <NEXT_PUBLIC_SITE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Admin ----------------------------------------------------------------
# Visit /admin?key=<ADMIN_TOKEN> once to get an admin cookie.
ADMIN_TOKEN="change-me-in-production"

# --- Sponsors -------------------------------------------------------------
# Key material for the daily-rotating visitor hash that tells a repeat
# impression from a new one. Any long random string. Optional: without it
# each server process picks its own, which is just as private but means two
# serverless instances can each count the same browser once.
# SPONSOR_SALT=""

# --- Serving under a path --------------------------------------------------
# Leave unset for a normal deployment. Set to e.g. "/test1" when another site
# rewrites a subpath to this app; internal links, assets, API calls and share
# links all pick it up.
# NEXT_PUBLIC_BASE_PATH="/test1"

# Set to 1 for a staging copy or a test mount on someone else's domain: every
# page goes noindex and robots.txt disallows everything.
# NEXT_PUBLIC_NOINDEX="1"
